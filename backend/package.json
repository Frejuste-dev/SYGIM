{
  "name": "sygim-backend",
  "version": "2.0.0",
  "description": "Backend API profesionnel pour SYGIM — Système de Gestion Immobilière",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:debug": "node --inspect-brk src/index.js",
    "seed": "node database/comprehensive_seed.js",
    "test": "jest --coverage --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:unit": "jest tests/unit",
    "pretest:integration": "node database/setup-test-db.js",
    "test:integration": "jest tests/integration --runInBand",
    "db:migrate": "node src/infrastructure/database/migrate.js",
    "db:migrate:baseline": "node src/infrastructure/database/migrate.js baseline",
    "lint": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "check": "npm run lint && npm run test",
    "prod:start": "NODE_ENV=production node src/index.js",
    "prod:build": "npm ci && npm test",
    "loadtest": "k6 run tests/load/load-test.js",
    "loadtest:smoke": "k6 run --vus 1 --duration 30s tests/load/load-test.js",
    "loadtest:stress": "k6 run --vus 100 --duration 2m tests/load/load-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mysql2": "^3.12.0",
    "pdfkit": "^0.14.0",
    "prom-client": "^15.1.3",
    "redis": "^6.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "node-forge": "^1.4.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "sygim",
    "gestion-immobiliere",
    "backend",
    "express",
    "rest-api",
    "architecture"
  ],
  "author": "SYGIM Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/sygim/backend.git"
  }
}
