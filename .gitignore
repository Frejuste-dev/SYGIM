# ==============================================================================
# SYGIM - .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets
.env*
!.env.example
!.env.*.example
!.env.docker.example
backend/.env*
!backend/.env.example
!backend/.env.*.example
CREDENTIALS_PRODUCTION.md
backend/certs/

# Logs & Runtime
logs/
*.log
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files & Backups
*.tmp*
.tmp*
backups/
routes_dump.txt
services_dump.txt
text.tex
fix*.js
backend/clean-dashes.js
backend/real_schema.txt
backend/real_schema_utf8.txt

# Test artifacts & Coverage
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/

# Build outputs & Bundles
dist/
dist-ssr/
build/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
