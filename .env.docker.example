# ╔══════════════════════════════════════════════════════════════════╗
# ║       SYGIM — Variables Docker (remplace .env en local)         ║
# ╚══════════════════════════════════════════════════════════════════╝

# Serveur
PORT=3000
NODE_ENV=production

# ⚠️ DB_HOST doit être le nom du service Docker (pas localhost !)
DB_HOST=mysql
DB_PORT=3306
DB_USER=sygim_user
DB_PASSWORD=<LOCAL_DB_PASSWORD>
DB_NAME=sygim_db
MYSQL_ROOT_PASSWORD=<LOCAL_ROOT_PASSWORD>

# JWT
JWT_SECRET=<LOCAL_JWT_SECRET>
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=<LOCAL_REFRESH_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Le frontend parle au backend via Nginx
CORS_ORIGIN=http://localhost:5001
